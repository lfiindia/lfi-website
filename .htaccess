RewriteEngine On

# If someone visits an old-style URL ending in .html, permanently redirect
# them to the clean version (e.g. /portfolio.html -> /portfolio). This
# keeps old bookmarks/links working while showing the new clean URL.
RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Serve the matching .html file when a clean URL is requested, without
# changing what's shown in the browser's address bar.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [L]

# Custom 404 page
ErrorDocument 404 /404.html
